# --- Server ---
PORT=5000
NODE_ENV=development
# Comma-separated if you need more than one (e.g. deployed frontend + local dev)
CORS_ORIGIN=http://localhost:5173

# --- Auth (Phase 1) ---
# tenant_id is derived server-side from this token — never accept it from the client
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Metadata / raw docs store (MongoDB) ---
# Local dev: mongodb://localhost:27017/rag_platform (via docker-compose.yml)
# Production: MongoDB Atlas free tier (https://www.mongodb.com/cloud/atlas/register)
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rag_platform
#   (mongodb+srv:// already enables TLS automatically — no extra config needed)
MONGODB_URI=mongodb://localhost:27017/rag_platform

# --- Vector store (pgvector) ---
# Local dev: postgresql://user:password@localhost:5432/rag_platform (via docker-compose.yml)
# Production: Neon free tier (https://neon.tech) or Supabase — both support the
# pgvector extension. Their connection strings include ?sslmode=require, which
# is auto-detected below (POSTGRES_SSL can force it on/off if needed).
POSTGRES_URL=postgresql://user:password@localhost:5432/rag_platform
POSTGRES_SSL=
PGVECTOR_TABLE=embeddings
# 'pgvector' for real use; the test suite forces 'memory' so it doesn't need a live Postgres
VECTOR_STORE_DRIVER=pgvector

# --- Redis (semantic cache backend) ---
# Local dev: redis://localhost:6379 (via docker-compose.yml)
# Production: Upstash free tier (https://upstash.com) — use the rediss:// (TLS)
# connection string they give you; ioredis enables TLS automatically for rediss://
REDIS_URL=redis://localhost:6379

# --- Semantic cache (Phase 5) ---
# 'redis' for real use; the test suite forces 'memory' so it doesn't need a live Redis
CACHE_DRIVER=redis
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=3600

# --- Embeddings (Gemini — Google AI Studio, free tier, no card required) ---
# Get a key at https://aistudio.google.com/apikey
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/models
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# --- Reranker (Cohere Rerank — hosted cross-encoder, free trial tier) ---
# Get a key at https://dashboard.cohere.com/api-keys (1,000 calls/month, no card required)
RERANKER_API_KEY=
RERANKER_API_URL=https://api.cohere.com/v2/rerank
RERANKER_MODEL=rerank-english-v3.0

# --- Generation (LLM — Groq, OpenAI-compatible API, free tier, no card required) ---
# Get a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-120b

# --- Ingestion / chunking (Layer 1) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_UPLOAD_FILE_SIZE_MB=10

# --- Retrieval (Layer 3: hybrid search + RRF + rerank) ---
RETRIEVAL_VECTOR_TOP_K=20
RETRIEVAL_BM25_TOP_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_TOP_N=5

# --- Per-tenant rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging (Phase 5: per-stage latency/cost, tagged with request_id + tenant_id) ---
LOG_LEVEL=info
# Optional: also append JSON log lines to this file. Leave blank for console-only.
LOG_FILE=
