# Vite only exposes vars prefixed with VITE_ to client code

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api

VITE_APP_NAME=RAG Platform

# Google OAuth Client ID for "Continue with Google" (Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth client ID -> Web application).
# Add http://localhost:5173 as an authorized JavaScript origin. Leave unset
# to show the button in its disabled "coming soon" state.
VITE_GOOGLE_CLIENT_ID=
